rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      // Set via Admin SDK: setCustomUserClaims(uid, { admin: true })
      return isSignedIn() && request.auth.token.admin == true;
    }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------- User profiles ----------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(['name', 'photoURL', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 50;
      allow update: if isOwner(userId) && onlyChanges(['name', 'photoURL']);
      allow delete: if isOwner(userId) || isAdmin();

      // Private subcollection: only the owner can see it
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---------- Posts (public read, author-controlled write) ----------
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.createdAt == request.time;
      allow update: if isOwner(resource.data.authorId)
                    && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isOwner(resource.data.authorId) || isAdmin();
    }

    // ---------- Default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
